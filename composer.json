{
  "name": "nfc-solutions/officalonetap",
  "description": "NFC Solutions - Three-page web application for NFC-enabled products",
  "type": "project",
  "require": {
    "php": "^8.1",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-session": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-gd": "*",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "files": ["config.php"]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.3"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "mkdir -p qr_codes && chmod 777 qr_codes"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}