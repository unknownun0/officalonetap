# Database Configuration (Use PlanetScale, Neon, or other MySQL-compatible)
DB_HOST=your-database-host
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASS=your-database-password

# Application Settings
APP_URL=https://your-project.vercel.app
APP_ENV=production

# Admin Contact Email
ADMIN_EMAIL=admin@example.com

# Session Security (Required for production)
SESSION_SECURE_COOKIE=1
SESSION_HTTP_ONLY=1
SESSION_SAME_SITE=Strict

# Optional: If using PlanetScale
# DATABASE_URL=mysql://user:pass@host/db?ssl_mode=verify_identity   