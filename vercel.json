{
  "version": 2,
  "buildCommand": "composer install --no-dev --optimize-autoloader",
  "devCommand": "php -S localhost:3000",
  "installCommand": "composer install",
  "regions": ["iad1"],
  "functions": {
    "api/**/*.php": {
      "runtime": "php@8.3",
      "maxDuration": 30
    },
    "*.php": {
      "runtime": "php@8.3",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.php"
    },
    {
      "source": "/admin/",
      "destination": "/admin.php"
    },
    {
      "source": "/account",
      "destination": "/account.php"
    },
    {
      "source": "/account/",
      "destination": "/account.php"
    },
    {
      "source": "/qr_codes/(.*)",
      "destination": "/qr_codes/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.php"
    }
  ],
  "headers": [
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/qr_codes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "APP_ENV": "production"
  }
}